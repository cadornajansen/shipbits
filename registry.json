      "type": "registry:block",
      "description": "The complete Shipbits chat and agent frontend, with a local demo adapter.",
      "css": {
        "@property --sb-chat-angle": {
          "syntax": "\"<angle>\"",
          "initial-value": "0deg",
          "inherits": "false"
        },
        "@keyframes sb-chat-beam": {
          "to": {
            "--sb-chat-angle": "360deg"
          }
        },
        "@keyframes sb-chat-pulse": {
          "0%, 100%": {
            "opacity": ".25"
          },
          "50%": {
            "opacity": ".9"
          }
        },
        "@keyframes sb-chat-sweep": {
          "0%, 100%": {
            "transform": "translateX(-16px)"
          },
          "50%": {
            "transform": "translateX(44px)"
          }
        },
        "@keyframes sb-chat-avatar": {
          "50%": {
            "filter": "hue-rotate(35deg)"
          }
        }
      }
    }
